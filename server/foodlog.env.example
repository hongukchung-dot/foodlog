# /etc/foodlog.env 로 복사한 뒤 값 채우기. 권한: chmod 600, root 소유 권장.
ANTHROPIC_API_KEY=sk-ant-...
# 공공데이터포털 "식품의약품안전처_식품영양성분DB정보" 인증키
# (https://www.data.go.kr/data/15127578/openapi.do — Decoding 키를 넣는다)
# 비워두면 /v1/food/search 만 비활성화되고 나머지는 정상 동작
MFDS_API_KEY=
# 앱 토큰. admin/friend 플레이버 별도 토큰을 쉼표로 구분 (예: openssl rand -hex 24 로 생성)
APP_TOKENS=admin-token-change-me,friend-token-change-me
# 토큰당 일일 분석 상한
DAILY_LIMIT=200
# 캐시/사용량 DB 경로
FOODLOG_DB=/opt/foodlog/cache.db
# 분석 모델
ANTHROPIC_MODEL=claude-sonnet-5
