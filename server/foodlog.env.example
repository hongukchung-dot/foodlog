# /etc/foodlog.env 로 복사한 뒤 값 채우기. 권한: chmod 600, root 소유 권장.
ANTHROPIC_API_KEY=sk-ant-...
# 식약처 식품안전나라 Open API 키 (https://openapi.foodsafetykorea.go.kr)
MFDS_API_KEY=
# 앱 토큰. admin/friend 플레이버 별도 토큰을 쉼표로 구분 (예: openssl rand -hex 24 로 생성)
APP_TOKENS=admin-token-change-me,friend-token-change-me
# 토큰당 일일 분석 상한
DAILY_LIMIT=200
# 캐시/사용량 DB 경로
FOODLOG_DB=/opt/foodlog/cache.db
# 분석 모델
ANTHROPIC_MODEL=claude-sonnet-5
