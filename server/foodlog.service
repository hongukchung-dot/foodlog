[Unit]
Description=FoodLog proxy server (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/foodlog
EnvironmentFile=/etc/foodlog.env
ExecStart=/opt/foodlog/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
